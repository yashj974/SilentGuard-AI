# Environment variables & secrets (NEVER commit real credentials)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Downloaded Google Cloud / OAuth provider credentials & keys
client_secret*.json
*credentials*.json
*service-account*.json
*service_account*.json
*.pem
*.key
*.p12

# Local SQLite databases
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Python / FastAPI backend
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/

# Node / Frontend
node_modules/
dist/
dist-ssr/
*.local

# Editor & OS files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.log
