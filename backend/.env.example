# SilentGuard AI Backend Environment Configuration
# Copy this file to backend/.env and populate your OAuth credentials.
# Never commit backend/.env or real client secrets to version control.

# 1. Database & Server URLs (Active Backend Port: 8000)
SILENTGUARD_DB_PATH=silentguard.db
SILENTGUARD_BACKEND_URL=http://localhost:8000
SILENTGUARD_FRONTEND_URL=http://localhost:5173

# 2. Admin Access & Bootstrap Account
SILENTGUARD_ADMIN_EMAILS=admin@silentguard.ai,founder@silentguard.ai
SILENTGUARD_BOOTSTRAP_ADMIN_EMAIL=admin@silentguard.ai
SILENTGUARD_BOOTSTRAP_ADMIN_PASSWORD=
SILENTGUARD_BOOTSTRAP_ADMIN_NAME=SilentGuard Admin

# 3. Google Cloud OAuth 2.0 (User Identity Sign-In)
# Console: https://console.cloud.google.com/apis/credentials
# Application Type: Web application
# Authorized JavaScript origins: http://localhost:5173
# Authorized redirect URI: http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# 4. GitHub OAuth 2.0 App (Repository Integration)
# Console: https://github.com/settings/developers -> OAuth Apps -> New OAuth App
# Homepage URL: http://localhost:5173
# Authorization callback URL: http://localhost:8000/api/integrations/github/callback
# Required OAuth Scopes: read:user user:email repo
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/integrations/github/callback

# 5. GitLab OAuth 2.0 Application (Repository Integration)
# Console: https://gitlab.com/-/user_settings/applications (or self-managed HTTPS instance)
# Redirect URI: http://localhost:8000/api/integrations/gitlab/callback
# Confidential: Yes | Required Scopes: read_user, read_api, read_repository
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_INSTANCE_URL=https://gitlab.com
GITLAB_REDIRECT_URI=http://localhost:8000/api/integrations/gitlab/callback

# 6. Bitbucket Cloud OAuth 2.0 Consumer (Repository Integration)
# Console: https://bitbucket.org/{workspace}/workspace/settings/api -> Add OAuth consumer
# Callback URL: http://localhost:8000/api/integrations/bitbucket/callback
# Required Permissions: Account (Read), Repositories (Read)
BITBUCKET_CLIENT_ID=
BITBUCKET_CLIENT_SECRET=
BITBUCKET_REDIRECT_URI=http://localhost:8000/api/integrations/bitbucket/callback

# 7. Admin Booking Notification SMTP Settings
ADMIN_NOTIFICATION_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
